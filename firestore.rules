/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model and validates data schemas
 * on write operations to ensure data integrity. The default security posture is to deny all access
 * unless explicitly granted.
 *
 * Data Structure & Validation:
 * - /users/{userId}: Private user profiles. On creation and update, rules verify that the document
 *   ID matches the user's UID and that the UID cannot be changed.
 * - /plan_tiers/{planTierId}: Publicly readable plan details. Client-side writes are disabled.
 * - /users/{userId}/visions/{visionId}: User-owned visions. On creation, a helper function
 *   `incomingVisionDataIsValid()` validates the entire data schema (e.g., `title` is a string,
 *   `isPublic` is a boolean). On update, immutable fields like `userId` and `id` are protected.
 * - /users/{userId}/roadmaps/{roadmapId}: User-owned roadmaps. Schema is validated on creation,
 *   and immutable fields are protected on update.
 * - Journaling Collections: `daily_plans`, `daily_logs`, and `decision_journal` are secured by
 *   ownership and have strict schema validation on write to ensure data integrity and immutability.
 *
 * Key Security Decisions:
 * - Schema Enforcement: Write operations are protected by functions that validate the incoming
 *   `request.resource.data` against the expected data types and structure. This prevents
 *   malformed or malicious data from being saved.
 * - Immutability: Key identifiers (`id`, `userId`, `visionId`) are locked down after creation.
 *   Journaling collections (`daily_logs`, `decision_journal`) are immutable (create-only).
 * - User Enumeration Disabled: `list` on `/users` is forbidden to prevent scraping user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incomingUserDataIsValid(data) {
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.displayName is string && data.displayName.size() > 0 &&
               data.planTierId is string;
    }

    function incomingVisionDataIsValid(userId, visionId) {
      let data = request.resource.data;
      let validCategories = ["Career", "Health", "Financial", "Personal Growth", "Relationships", "Legacy"];
      return data.id == visionId &&
             data.userId == userId &&
             data.title is string && data.title.size() > 0 &&
             data.goal is string && data.goal.size() > 0 &&
             data.category is string && data.category in validCategories &&
             data.isPublic is bool &&
             data.createdAt == request.time;
    }

    function incomingRoadmapDataIsValid(userId, roadmapId) {
      let data = request.resource.data;
      return data.id == roadmapId &&
             data.visionId == roadmapId &&
             data.userId == userId &&
             data.visionTimeline is list &&
             data.yearlyMilestones is list &&
             data.monthlySprints is list &&
             data.weeklyTactics is list &&
             data.dailyHabits is list;
    }
    
    function incomingDailyPlanIsValid(data) {
      // Basic validation: check for the presence and type of 'antiGoals' list.
      // Firestore rules cannot iterate, so we can't check every item.
      return data.antiGoals is list;
    }

    function incomingDailyLogIsValid(data) {
        let baseValid = data.createdAt == request.time && data.type is string;
        if (data.type == 'evening_reflection') {
            return baseValid && data.content is string && data.content.size() > 0;
        }
        if (data.type == 'nightly_review') {
            return baseValid && data.date is string &&
                   data.win is string && data.win.size() > 0 &&
                   data.learning is string && data.learning.size() > 0 &&
                   data.gratitude is string && data.gratitude.size() > 0;
        }
        if (data.type == 'weekly_retro') {
            return baseValid && data.date is string &&
                   data.wins is string && data.wins.size() > 0 &&
                   data.challenges is string && data.challenges.size() > 0 &&
                   data['next-week'] is string && data['next-week'].size() > 0;
        }
        return false;
    }

    function incomingDecisionJournalIsValid(data) {
        return data.createdAt == request.time &&
               data.decision is string && data.decision.size() > 0 &&
               data.visions is list &&
               data.analysis is map &&
               data.analysis.score is number &&
               data.analysis.explanation is string &&
               data.analysis.recommendation is string;
    }

    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent user enumeration
      allow create: if isOwner(userId) && incomingUserDataIsValid(request.resource.data);
      allow update: if isOwner(userId)
                    // Immutable fields must not change.
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.email == resource.data.email
                    // Stripe fields are managed by the backend webhook, not the client.
                    && request.resource.data.stripeCustomerId == resource.data.stripeCustomerId
                    && request.resource.data.stripeSubscriptionId == resource.data.stripeSubscriptionId
                    && request.resource.data.stripePriceId == resource.data.stripePriceId
                    // Client is allowed to update their display name.
                    && request.resource.data.displayName is string
                    // Client is allowed to keep their plan or downgrade to the free 'trailblazer' plan.
                    && (request.resource.data.planTierId == resource.data.planTierId ||
                        request.resource.data.planTierId == 'trailblazer');
      allow delete: if isOwner(userId);

      // Visions Subcollection
      match /visions/{visionId} {
        allow get: if isOwner(userId) || (get(/databases/$(database)/documents/users/$(userId)/visions/$(visionId)).data.isPublic == true);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && incomingVisionDataIsValid(userId, visionId);
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }


      // Roadmaps Subcollection
      match /roadmaps/{roadmapId} {
        allow get: if isOwner(userId) || (get(/databases/$(database)/documents/users/$(userId)/visions/$(roadmapId)).data.isPublic == true);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && incomingRoadmapDataIsValid(userId, roadmapId);
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id && request.resource.data.userId == resource.data.userId && request.resource.data.visionId == resource.data.visionId;
        allow delete: if isOwner(userId);
      }

      // New Feature Collections
      match /daily_plans/{planId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && incomingDailyPlanIsValid(request.resource.data);
      }
      
      match /daily_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incomingDailyLogIsValid(request.resource.data);
        allow update, delete: if false; // Journal entries should be immutable.
      }
      
      match /decision_journal/{decisionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incomingDecisionJournalIsValid(request.resource.data);
        allow update, delete: if false; // Journal entries should be immutable.
      }
    }

    match /plan_tiers/{planTierId} {
      allow get, list: if true;
      allow write: if false; // Protect plan data from client-side writes
    }
  }
}
