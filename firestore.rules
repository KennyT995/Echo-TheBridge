/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for all user-specific data,
 * ensuring that users can only access their own information. Publicly readable data, such as
 * subscription plan details, is segregated into its own collection. The default security posture
 * is to deny access unless explicitly granted.
 *
 * Data Structure: The data is organized into several collections:
 * - /users/{userId}: Contains private user profile information. Access is strictly controlled
 *   by matching the authenticated user's ID with the document's ID in the path.
 * - /plan_tiers/{planTierId}: Contains public reference data about subscription plans.
 *   This data is readable by any authenticated user but is not writable from the client-side
 *   to protect its integrity.
 * - /users/{userId}/visions/{visionId}: Subcollection storing a user's visions.
 * - /users/{userId}/roadmaps/{roadmapId}: Subcollection storing generated roadmaps.
 *
 * Key Security Decisions:
 * - User Enumeration is Disabled: A `list` operation on the top-level `/users` collection is
 *   explicitly forbidden (`allow list: if false;`). This is a critical security measure to
 *   prevent malicious actors from downloading a list of all application users.
 * - Admin-Only Data is Read-Only: The `/plan_tiers` collection is treated as administrative
 *   data. To ensure its integrity, all client-side write operations are disabled.
 *   This data must be managed through a trusted server-side environment.
 * - Self-Creation of User Profile: A user is permitted to create their own user document in
 *   `/users/{userId}` only if the document ID matches their authentication UID.
 * - Plan-Based Limitations: Creating a new vision is only allowed if the user has not
 *   exceeded the `maxVisions` limit defined by their current plan tier. This is checked
 *   using `get()` calls to the user's profile and the plan tier documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function hasValidUserIdOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    function isAttemptingToChangeId() {
      // The 'id' field in the incoming data must not differ from the existing one.
      return 'id' in request.resource.data && request.resource.data.id != resource.data.id;
    }
    
    function canCreateVision(userId) {
      // FIXME: Implement a scalable counter or Cloud Function to enforce limits. 
      // 'get' on a collection is not supported in rules.
      return true;
    }


    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && hasValidUserIdOnCreate(userId);
      allow update: if isExistingOwner(userId) && !isAttemptingToChangeId();
      allow delete: if isExistingOwner(userId);

      // Visions Subcollection
      match /visions/{visionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && canCreateVision(userId);
        allow update, delete: if isOwner(userId);
      }

      // Roadmaps Subcollection
      match /roadmaps/{roadmapId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /plan_tiers/{planTierId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
