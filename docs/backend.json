{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "planTierId": {
          "type": "string",
          "description": "Reference to the PlanTier. (Relationship: PlanTier 1:N User)"
        },
        "stripeCustomerId": {
          "type": "string",
          "description": "The user's Stripe Customer ID."
        },
        "stripeSubscriptionId": {
          "type": "string",
          "description": "The user's active Stripe Subscription ID."
        },
        "stripePriceId": {
          "type": "string",
          "description": "The Stripe Price ID of the user's current plan."
        }
      },
      "required": ["id", "email", "displayName", "planTierId"]
    },
    "PlanTier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PlanTier",
      "type": "object",
      "description": "Represents a plan tier with specific features and limitations.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the plan tier."
        },
        "name": {
          "type": "string",
          "description": "The name of the plan tier (e.g., Basic, Premium)."
        },
        "maxVisions": {
          "type": "number",
          "description": "The maximum number of visions allowed for this plan tier."
        },
        "aiFeaturesEnabled": {
          "type": "boolean",
          "description": "Indicates whether AI features are enabled for this plan tier."
        },
        "price": {
          "type": "number",
          "description": "The monthly price of the plan."
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of features included in the plan."
        }
      },
      "required": [
        "id",
        "name",
        "maxVisions",
        "aiFeaturesEnabled",
        "price",
        "features"
      ]
    },
    "Vision": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vision",
      "type": "object",
      "description": "Represents a user's vision, including different time horizons.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the vision."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns this vision."
        },
        "title": {
          "type": "string",
          "description": "A user-defined title for the vision."
        },
        "goal": {
          "type": "string",
          "description": "The user's primary goal or vision."
        },
        "category": {
          "type": "string",
          "description": "The category of the vision (e.g., Career, Health)."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the vision is publicly shareable."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the vision was created."
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "goal",
        "category",
        "isPublic",
        "createdAt"
      ]
    },
    "Roadmap": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Roadmap",
      "type": "object",
      "description": "Represents the AI-generated roadmap for a specific vision.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the roadmap, same as the vision ID."
        },
        "visionId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "yearlyMilestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        },
        "monthlySprints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        },
        "weeklyTactics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        },
        "dailyHabits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        }
      },
      "required": [
        "id",
        "visionId",
        "userId",
        "yearlyMilestones",
        "monthlySprints",
        "weeklyTactics",
        "dailyHabits"
      ]
    },
    "DailyPlan": {
      "title": "Daily Plan",
      "description": "Stores user's daily plans, including anti-goals.",
      "type": "object",
      "properties": {
        "antiGoals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["id", "text", "completed"]
          }
        }
      }
    },
    "DailyLog": {
      "title": "Daily Log",
      "description": "Represents different types of daily or weekly user logs.",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "enum": ["evening_reflection", "nightly_review", "weekly_retro"]
        }
      },
      "required": ["createdAt", "type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "evening_reflection" },
            "content": { "type": "string" }
          },
          "required": ["content"]
        },
        {
          "properties": {
            "type": { "const": "nightly_review" },
            "date": { "type": "string" },
            "win": { "type": "string" },
            "learning": { "type": "string" },
            "gratitude": { "type": "string" }
          },
          "required": ["date", "win", "learning", "gratitude"]
        },
        {
          "properties": {
            "type": { "const": "weekly_retro" },
            "date": { "type": "string" },
            "wins": { "type": "string" },
            "challenges": { "type": "string" },
            "next-week": { "type": "string" }
          },
          "required": ["date", "wins", "challenges", "next-week"]
        }
      ]
    },
    "DecisionJournal": {
      "title": "Decision Journal",
      "description": "A record of a user's decision and its alignment with their visions.",
      "type": "object",
      "properties": {
        "decision": { "type": "string" },
        "visions": { "type": "array", "items": { "type": "string" } },
        "analysis": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "explanation": { "type": "string" },
            "recommendation": { "type": "string" }
          },
          "required": ["score", "explanation", "recommendation"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["decision", "visions", "analysis", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile data. Secured by path-based ownership, where only the user with the matching userId can access their own document."
    },
    "/plan_tiers/{planTierId}": {
      "schema": {
        "$ref": "#/entities/PlanTier"
      },
      "description": "Stores plan tier information. This data is publicly readable by all users but is not writable from the client-side to protect its integrity."
    },
    "/users/{userId}/visions/{visionId}": {
      "schema": {
        "$ref": "#/entities/Vision"
      },
      "description": "Stores the visions created by a user as a subcollection. Access is restricted to the owner unless the vision is explicitly marked as public."
    },
    "/users/{userId}/roadmaps/{roadmapId}": {
      "schema": {
        "$ref": "#/entities/Roadmap"
      },
      "description": "Stores the AI-generated roadmaps for a user's vision. Access is restricted to the owner, or public if the corresponding vision is public."
    },
    "/users/{userId}/daily_plans/{planId}": {
      "schema": {
        "$ref": "#/entities/DailyPlan"
      },
      "description": "Stores user's daily plans, including the 'Not-To-Do List'. The document ID is the date (YYYY-MM-DD). Secured by ownership."
    },
    "/users/{userId}/daily_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/DailyLog"
      },
      "description": "Stores various journal entries, like evening reflections and weekly reviews. Secured by ownership."
    },
    "/users/{userId}/decision_journal/{decisionId}": {
      "schema": {
        "$ref": "#/entities/DecisionJournal"
      },
      "description": "Stores records of decisions and their AI-powered alignment analysis. Secured by ownership."
    }
  }
}
