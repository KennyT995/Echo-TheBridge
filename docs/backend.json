{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "planTierId": {
          "type": "string",
          "description": "Reference to the PlanTier. (Relationship: PlanTier 1:N User)"
        }
      },
      "required": [
        "id",
        "email",
        "planTierId"
      ]
    },
    "PlanTier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PlanTier",
      "type": "object",
      "description": "Represents a plan tier with specific features and limitations.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the plan tier."
        },
        "name": {
          "type": "string",
          "description": "The name of the plan tier (e.g., Basic, Premium)."
        },
        "maxVisions": {
          "type": "number",
          "description": "The maximum number of visions allowed for this plan tier."
        },
        "aiFeaturesEnabled": {
          "type": "boolean",
          "description": "Indicates whether AI features are enabled for this plan tier."
        },
        "price": {
          "type": "number",
          "description": "The monthly price of the plan."
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of features included in the plan."
        }
      },
      "required": [
        "id",
        "name",
        "maxVisions",
        "aiFeaturesEnabled",
        "price",
        "features"
      ]
    },
    "Vision": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vision",
      "type": "object",
      "description": "Represents a user's vision, including different time horizons.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the vision."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns this vision."
        },
        "title": {
          "type": "string",
          "description": "A user-defined title for the vision."
        },
        "goal": {
          "type": "string",
          "description": "The user's primary goal or vision."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the vision was created."
        }
      },
      "required": ["id", "userId", "title", "goal", "createdAt"]
    },
    "Roadmap": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Roadmap",
      "type": "object",
      "description": "Represents the AI-generated roadmap for a specific vision.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the roadmap, same as the vision ID."
        },
        "visionId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "yearlyMilestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        },
        "monthlySprints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        },
        "weeklyTactics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        },
        "dailyHabits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["text", "completed"]
          }
        }
      },
      "required": ["id", "visionId", "userId", "yearlyMilestones", "monthlySprints", "weeklyTactics", "dailyHabits"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile data. Secured by path-based ownership, where only the user with the matching userId can access the document. Includes denormalized 'planTierId' for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/plan_tiers/{planTierId}",
        "definition": {
          "entityName": "PlanTier",
          "schema": {
            "$ref": "#/backend/entities/PlanTier"
          },
          "description": "Stores plan tier information. Access control should be set up to restrict editing to admin users.",
          "params": [
            {
              "name": "planTierId",
              "description": "The unique identifier for the plan tier."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/visions/{visionId}",
        "definition": {
          "entityName": "Vision",
          "schema": {
            "$ref": "#/backend/entities/Vision"
          },
          "description": "Stores visions created by a user. Subcollection of users.",
          "params": [
            { "name": "userId", "description": "The user's unique ID." },
            { "name": "visionId", "description": "The vision's unique ID." }
          ]
        }
      },
      {
        "path": "/users/{userId}/roadmaps/{roadmapId}",
        "definition": {
          "entityName": "Roadmap",
          "schema": {
            "$ref": "#/backend/entities/Roadmap"
          },
          "description": "Stores roadmaps generated for a user's vision. Subcollection of users.",
          "params": [
            { "name": "userId", "description": "The user's unique ID." },
            { "name": "roadmapId", "description": "The roadmap's unique ID, same as visionId." }
          ]
        }
      }
    ]
  }
}
